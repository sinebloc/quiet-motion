<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: the sample draws its own header, and edge-to-edge is the point.
         The splash colours matter more than usual here — a white cold-start flash is
         the first thing a screen recording of this app would show. -->
    <style name="Theme.QuietMotionSample" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#FF101014</item>
        <item name="android:windowSplashScreenBackground">#FF101014</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
